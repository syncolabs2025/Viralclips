# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080   # 7 days

# ── Database — Supabase ───────────────────────────────────────────────────────
# Get this from: Supabase Dashboard → Project Settings → Database → Connection string
#
# Use the "Transaction" pooler (port 6543) for API / Cloud Run (stateless):
#   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# Use the "Session" pooler (port 5432) or direct connection for the worker
# (long-lived process that holds transactions open during video processing):
#   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# For local dev you can use either — Transaction pooler is fine:
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Queue — Upstash Redis ─────────────────────────────────────────────────────
# Get this from: Upstash Console → your database → "Redis URL" (the rediss:// TLS one)
# It looks like: rediss://default:[password]@[name]-[region].upstash.io:6379
REDIS_URL=rediss://default:[password]@[endpoint].upstash.io:6379

# ── Google Cloud Storage ──────────────────────────────────────────────────────
# Leave GCS_BUCKET empty to use local disk storage (for local dev)
GCS_BUCKET=
GCS_PROJECT=
# Path to service account JSON key (or use Application Default Credentials)
GOOGLE_APPLICATION_CREDENTIALS=

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Resend (email) ────────────────────────────────────────────────────────────
# Get your API key at https://resend.com — leave empty to skip email sending in dev
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@viralclips.app

# ── Dev bypass ────────────────────────────────────────────────────────────────
# Set to false to skip email verification entirely (new users are auto-verified)
# Change to true (or remove) before going to production
EMAIL_VERIFICATION_REQUIRED=false

# ── App ───────────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
# Local storage paths (dev only — ignored when GCS_BUCKET is set)
LOCAL_UPLOAD_DIR=/tmp/viralclips/uploads
LOCAL_OUTPUT_DIR=/tmp/viralclips/outputs
