# API Keys
OPENAI_API_KEY=sk-...
RUNWAY_API_KEY=key_...

# Redis
REDIS_URL=redis://redis:6379/0

# Storage paths (inside container)
UPLOAD_DIR=/data/uploads
CLIPS_DIR=/data/clips
OUTPUT_DIR=/data/outputs

# Optional: public base URL used to serve clip files to Runway ML.
# If unset, clips are base64-encoded and sent inline (fine for clips < 20 MB).
# In production set this to your public domain, e.g. https://api.example.com
PUBLIC_BASE_URL=

# Database
DATABASE_URL=sqlite:////data/viralclips.db
